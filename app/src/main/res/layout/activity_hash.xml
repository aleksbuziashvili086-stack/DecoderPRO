<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hash Lab"
            android:textColor="@color/neon_cyan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/hash_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:hint="შეიყვანე ტექსტი..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btn_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🔐 Compute Hashes"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/neon_cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MD5:"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hash_md5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHA-1:"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hash_sha1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHA-256:"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hash_sha256"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHA-512:"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hash_sha512"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_hash_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Copy All"
                android:textColor="@color/neon_cyan"
                android:backgroundTint="@color/bg_card" />

            <Button
                android:id="@+id/btn_hash_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🗑 Clear"
                android:textColor="@color/neon_red"
                android:backgroundTint="@color/bg_card" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
