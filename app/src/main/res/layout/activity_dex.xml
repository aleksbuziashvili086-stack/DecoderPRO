<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="DEX Header" android:textColor="@color/neon_cyan"
        android:textSize="24sp" android:textStyle="bold" android:paddingBottom="16dp"/>
    <Button android:id="@+id/btn_dex_pick" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📁 აირჩიე APK"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_green"/>
    <Button android:id="@+id/btn_dex_clear" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🗑 Clear"
        android:textColor="@color/neon_red" android:backgroundTint="@color/bg_card"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp">
        <TextView android:id="@+id/dex_output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/neon_green"
            android:background="@color/bg_card" android:padding="12dp"
            android:fontFamily="monospace" android:textSize="11sp"/>
    </ScrollView>
</LinearLayout>
