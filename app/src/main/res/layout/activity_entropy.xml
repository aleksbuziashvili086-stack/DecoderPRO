<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entropy Analyzer"
        android:textColor="@color/neon_cyan"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/entropy_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top"
        android:hint="შეიყვანე ტექსტი ან მონაცემები..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:background="@color/bg_card"
        android:padding="12dp"
        android:inputType="textMultiLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_entropy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Calculate"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/neon_cyan" />

        <Button
            android:id="@+id/btn_entropy_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🗑 Clear"
            android:textColor="@color/neon_red"
            android:backgroundTint="@color/bg_card" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/entropy_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/neon_green"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:minLines="10" />
    </ScrollView>

</LinearLayout>
