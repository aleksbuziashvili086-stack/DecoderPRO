<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="File Comparison" android:textColor="@color/neon_cyan"
        android:textSize="24sp" android:textStyle="bold" android:paddingBottom="12dp"/>
    <Button android:id="@+id/btn_fc_pick1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📁 აირჩიე ფაილი 1 (ორიგინალი)"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_green"/>
    <Button android:id="@+id/btn_fc_pick2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="📁 აირჩიე ფაილი 2 (შეცვლილი)"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_purple"/>
    <TextView android:id="@+id/fc_info" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/text_muted" android:textSize="11sp"
        android:background="@color/bg_card" android:padding="8dp"
        android:fontFamily="monospace"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btn_fc_compare" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🔍 შედარება" android:textColor="@color/bg_dark"
            android:backgroundTint="@color/neon_cyan"/>
        <Button android:id="@+id/btn_fc_clear" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="🗑 Clear"
            android:textColor="@color/neon_red" android:backgroundTint="@color/bg_card"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp">
        <TextView android:id="@+id/fc_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/neon_green"
            android:background="@color/bg_card" android:padding="10dp"
            android:fontFamily="monospace" android:textSize="10sp"/>
    </ScrollView>
    <Button android:id="@+id/btn_fc_copy" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="📋 Copy Report" android:textColor="@color/neon_cyan"
        android:backgroundTint="@color/bg_card"/>
</LinearLayout>
