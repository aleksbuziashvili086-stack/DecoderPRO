<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark" android:padding="12dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Binary Diff Analyzer" android:textColor="@color/neon_cyan"
        android:textSize="22sp" android:textStyle="bold" android:paddingBottom="10dp"/>

    <Button android:id="@+id/btn_fc_pick1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📁 File 1 (ორიგინალი)"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_green"
        android:textSize="12sp"/>

    <Button android:id="@+id/btn_fc_pick2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="📁 File 2 (შეცვლილი)"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_purple"
        android:textSize="12sp"/>

    <TextView android:id="@+id/fc_info" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/text_muted" android:textSize="10sp"
        android:background="@color/bg_card" android:padding="6dp"
        android:fontFamily="monospace"/>

    <Button android:id="@+id/btn_fc_compare" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="🔍 FULL COMPARISON" android:textColor="@color/bg_dark"
        android:backgroundTint="@color/neon_cyan" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btn_fc_copy" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="📋 Report" android:textColor="@color/neon_cyan"
            android:backgroundTint="@color/bg_card" android:textSize="10sp"/>
        <Button android:id="@+id/btn_fc_copy_diff" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:text="📋 Diff Only"
            android:textColor="@color/neon_green" android:backgroundTint="@color/bg_card"
            android:textSize="10sp"/>
        <Button android:id="@+id/btn_fc_edit" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:text="✏️ Edit"
            android:textColor="@color/neon_yellow" android:backgroundTint="@color/bg_card"
            android:textSize="10sp"/>
        <Button android:id="@+id/btn_fc_clear" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:text="🗑"
            android:textColor="@color/neon_red" android:backgroundTint="@color/bg_card"
            android:textSize="10sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp">
        <TextView android:id="@+id/fc_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/neon_green"
            android:background="@color/bg_card" android:padding="8dp"
            android:fontFamily="monospace" android:textSize="9sp"/>
    </ScrollView>

</LinearLayout>
