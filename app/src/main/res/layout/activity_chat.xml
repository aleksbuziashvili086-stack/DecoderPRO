<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <TextView android:id="@+id/chat_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="უკან" android:textColor="@color/accent_2" android:textSize="15sp" />
        <TextView android:id="@+id/chat_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="საუბარი" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/chat_file" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="ფაილი" android:textColor="@color/accent_2" />
        <TextView android:id="@+id/chat_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="სურათი" android:textColor="@color/accent_2" />
        <TextView android:id="@+id/chat_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="ხმა" android:textColor="@color/accent_2" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg_soft" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="შეტყობინება" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:maxLines="6" android:padding="14dp" android:textColor="@color/text" android:textColorHint="@color/muted" />
        <TextView android:id="@+id/chat_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_send" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:text="გაგზავნა" android:textColor="@color/text" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
