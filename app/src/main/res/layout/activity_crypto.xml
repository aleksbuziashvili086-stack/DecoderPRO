<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Crypto Tools" android:textColor="@color/neon_cyan"
        android:textSize="24sp" android:textStyle="bold" android:paddingBottom="12dp"/>
    <EditText android:id="@+id/crypto_input" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minLines="3" android:gravity="top"
        android:hint="შეიყვანე დაშიფრული ტექსტი..." android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary" android:background="@color/bg_card"
        android:padding="10dp" android:inputType="textMultiLine"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btn_crypto_xor" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="XOR"
            android:textColor="@color/neon_cyan" android:backgroundTint="@color/bg_card" android:textSize="10sp"/>
        <Button android:id="@+id/btn_crypto_caesar" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
            android:text="Caesar" android:textColor="@color/neon_cyan" android:backgroundTint="@color/bg_card" android:textSize="10sp"/>
        <Button android:id="@+id/btn_crypto_freq" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
            android:text="Frequency" android:textColor="@color/neon_green" android:backgroundTint="@color/bg_card" android:textSize="10sp"/>
        <Button android:id="@+id/btn_crypto_auto" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
            android:text="Auto" android:textColor="@color/neon_purple" android:backgroundTint="@color/bg_card" android:textSize="10sp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp">
        <TextView android:id="@+id/crypto_output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/neon_green"
            android:background="@color/bg_card" android:padding="8dp"
            android:fontFamily="monospace" android:textSize="9sp"/>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/btn_crypto_copy" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="📋 Copy"
            android:textColor="@color/neon_cyan" android:backgroundTint="@color/bg_card"/>
        <Button android:id="@+id/btn_crypto_clear" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
            android:text="🗑 Clear" android:textColor="@color/neon_red" android:backgroundTint="@color/bg_card"/>
    </LinearLayout>
</LinearLayout>
