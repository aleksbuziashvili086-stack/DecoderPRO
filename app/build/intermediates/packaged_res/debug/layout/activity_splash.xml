<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo Circle -->
        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_logo"
            android:background="@drawable/bg_logo_circle"
            android:padding="30dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textColor="@color/neon_cyan"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:letterSpacing="0.3" />

        <ProgressBar
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:layout_marginTop="60dp"
            android:progressTint="@color/neon_cyan"
            android:progressBackgroundTint="@color/border"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true" />

    </LinearLayout>
</RelativeLayout>
